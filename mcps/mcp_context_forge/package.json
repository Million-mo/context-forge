{
  "name": "@context-forge/mcp-context-forge",
  "version": "0.4.0",
  "description": "Context Forge unified MCP: sandboxed code execution + FTS5 content indexing + session memory & recall",
  "type": "module",
  "bin": {
    "mcp_context_forge": "./dist/install.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:start": "npm run build && node dist/server.js"
  },
  "dependencies": {
    "@context-forge/shared-types": "file:../shared-types",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
