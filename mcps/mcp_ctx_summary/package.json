{
  "name": "@context-forge/mcp-ctx-summary",
  "version": "0.3.0",
  "description": "Context Forge MCP: intent-driven recall + FTS search over session summaries",
  "type": "module",
  "bin": {
    "mcp_ctx_summary": "./dist/install.js"
  },
  "scripts": {
