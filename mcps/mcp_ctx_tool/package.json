{
  "name": "@context-forge/mcp-ctx-tool",
  "version": "0.3.0",
  "description": "Context Forge MCP: sandboxed code execution + FTS5 content indexing",
  "type": "module",
  "bin": {
    "mcp_ctx_tool": "./dist/server.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:start": "npm run build && node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
