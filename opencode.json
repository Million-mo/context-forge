{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ["./ctx_plugin/src/rtk.ts", {}]
  ],
  "permission": {
    "bash": {
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "grep *": "allow",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "dir_size": "ask"
  }
}
